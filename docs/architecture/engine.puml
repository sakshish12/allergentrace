@startuml engine
!include _style.iuml
title allergen_engine – building block view, level 2
left to right direction

package "allergen_engine (plain Python, no Django)" {
  [propagation\ndeclare_all\n(BR-1, BR-2, BR-4)] as prop
  [graph\ntopological order,\ncycle check (BR-5)] as graph
  [cross_contact\nshared equipment\n(BR-3)] as cc
  [impact\ndiff of declarations\n(US-10)] as impact
  [policy\nmerge, pending removals\n(BR-6)] as policy
  [model\nAllergen, Status,\nnodes, Declaration] as model
  interface "RecipeRepository\n(port)" as port
  [InMemoryRepository\n(for tests)] as mem
}
[recipes.DjangoRecipeRepository\n(adapter)] as adapter

prop --> graph
prop --> cc
prop --> port
prop --> model
cc --> model
impact --> model
policy --> model
mem ..|> port
adapter ..|> port
@enduml

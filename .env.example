# Environment variables of AllergenTrace. Never commit real values.
# Connection string of the PostgreSQL database (in the cloud: Neon, pooled connection, sslmode=require)
DATABASE_URL=postgres://allergentrace:allergentrace@localhost:5432/allergentrace
# Long random string; generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only for local development
DJANGO_DEBUG=False
# Comma-separated host names (Render adds its own host name automatically)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# US-20 approval e-mails. Without a key, e-mails are only printed to the log.
# Brevo API key (free plan) and a sender address that is verified in Brevo
BREVO_API_KEY=
DJANGO_DEFAULT_FROM_EMAIL=AllergenTrace <you@example.com>
# Contact address shown in the privacy policy and the terms of use
DJANGO_CONTACT_EMAIL=
